{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "game8arena",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-10",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": ["/signal/*", "/turn"]
  },
  // Browser-hosted multiplayer rooms: one Durable Object per room code relays the WebRTC set-up messages.
  "durable_objects": {
    "bindings": [{ "name": "SIGNAL", "class_name": "SignalRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SignalRoom"] }]
}
